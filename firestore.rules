rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // License checks and APK download authorization use trusted Cloud
    // Functions. Direct license reads and writes are restricted to admins.
    match /licenses/{deviceId} {
      allow read, write: if isAdmin();
    }
    match /appConfig/{document=**} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
